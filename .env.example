# Copy this file to .env and fill in the values, or let setup_node.py create it.
# Never commit .env; it contains the node credentials and JWT.

# vivariumiq API and MQTT broker. MQTT uses TLS on 8883; the broker hostname must
# stay a DNS-only (grey cloud) record pointing at the EC2 IP -- do not turn on
# the Cloudflare proxy, which only handles HTTP(S)
VIVARIUMIQ_API_URL=https://vivariumiq.pjmisev.com
VIVARIUMIQ_MQTT_BROKER=vivariumiq.pjmisev.com
VIVARIUMIQ_MQTT_PORT=8883

# Node identity. setup_node.py fills these in automatically.
VIVARIUMIQ_NODE_ID=
VIVARIUMIQ_NODE_TOKEN=
VIVARIUMIQ_EMAIL=
VIVARIUMIQ_PASSWORD=

# Node registration details, change manually
VIVARIUMIQ_NODE_NAME=johndoe-outdoor-garden
VIVARIUMIQ_NODE_LOCATION=Dublin, Ireland

VIVARIUMIQ_NODE_LATITUDE=53.32382908805492
VIVARIUMIQ_NODE_LONGITUDE=-6.3176879781791895

# Runtime
VIVARIUMIQ_READ_INTERVAL_S=60.0
